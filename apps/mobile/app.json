{
  "expo": {
    "name": "ToolNest",
    "slug": "toolnest",
    "scheme": "toolnest",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F7FB",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.localtools.private"
    },
    "android": {
      "package": "com.localtools.private",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EAF2FF"
      }
    },
    "plugins": [
      "expo-document-picker",
      "expo-sqlite"
    ],
    "extra": {
      "privacy": "All document processing runs on the device",
      "brand": "ToolNest"
    },
    "icon": "./assets/icon.png"
  }
}
