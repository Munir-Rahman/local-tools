{
  "expo": {
    "name": "ToolNest",
    "slug": "toolnest",
    "scheme": "toolnest",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#fffaf5",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.localtools.private"
    },
    "android": {
      "package": "com.localtools.private",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fff4e9"
      }
    },
    "plugins": [
      "expo-document-picker",
      "expo-sqlite"
    ],
    "extra": {
      "privacy": "All document processing runs on the device",
      "brand": "ToolNest",
      "eas": {
        "projectId": "8a4305aa-a216-46a5-85cf-46f0c7f4fb39"
      }
    },
    "icon": "./assets/icon.png",
    "owner": "munirrahmani"
  }
}
