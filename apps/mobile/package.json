    "expo-print": "~58.0.7",
    "expo-sharing": "~58.0.19",
    "expo-sqlite": "~58.0.14",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "^15.12.1",
    "pdf-lib": "^1.17.1",
