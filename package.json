{
  "name": "local-tools",
  "private": true,
  "version": "0.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @local-tools/web",
    "build": "npm run build --workspace @local-tools/web",
    "preview": "npm run preview --workspace @local-tools/web",
    "typecheck": "npm run typecheck --workspace @local-tools/web",
    "test": "node --experimental-strip-types --test apps/web/tests/*.test.mjs",
    "desktop:run": "npm run build && npm run start --workspace @local-tools/desktop",
    "desktop:win": "npm run build && npm run dist:win --workspace @local-tools/desktop",
    "desktop:check": "node --test apps/desktop/tests/*.test.cjs",
    "windows:diagnose": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/diagnose-windows.ps1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
